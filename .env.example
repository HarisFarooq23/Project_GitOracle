# Copy to InternHub/.env (same folder as app.py).

# Flask → Firestore: mirrors PostgreSQL `users` rows only into collection "users".

# Prefer a path relative to InternHub/ so it works everywhere:
#   FIREBASE_CREDENTIALS_PATH=secrets/firebase-adminsdk.json

# Windows absolute paths (use forward slashes OR double backslashes OR quotes):
#   FIREBASE_CREDENTIALS_PATH=C:/Users/You/Downloads/dbms-xxxxx-firebase-adminsdk.json
#
# Optionally paste the JSON as one line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}

FIREBASE_CREDENTIALS_PATH=
